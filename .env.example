# My DeMolay Bulgaria — environment variables (Vite exposes only VITE_* to the browser).
# Copy to `.env.local` to override locally. Never put secrets in VITE_* variables: they ship to the client.

# Demo mode (default: true). Enables the "Demo access" cards on the login page and the
# "Demo role switcher". Set to "false" to preview the production-like experience; the role
# switcher cannot be activated when this is "false".
VITE_DEMO_MODE=true

# Data source: "mock" (default — session-only in-memory repositories) or "api"
# (placeholder FastAPI client; every call fails with "API not available in prototype"
# unless VITE_API_BASE_URL points at a real backend).
VITE_DATA_SOURCE=mock

# Future FastAPI base URL, e.g. https://api.demolay.bg/api/v1 (unused while VITE_DATA_SOURCE=mock).
VITE_API_BASE_URL=

# Simulated network latency for mock repositories, in milliseconds.
# A single number ("300") or a range ("250-450", the default). Use 0 for instant responses.
VITE_MOCK_LATENCY_MS=250-450
